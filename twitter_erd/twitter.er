title {label: "Twitter ER Diagram"}

[users]
  *id {label: "bigint, not null"}
  email {label: "varchar, not null, uniq"}
  user_name {label: "varchar, not null, uniq"}
  phone_number {label: "varchar, null, uniq"}
  password_digest {label: "varchar, not null"}
  display_name {label: "varchar, null"}
  bio {label: "varchar, null"}
  location {label: "varchar, null"}
  website {label: "varchar, null"}
  birth_date {label: "date, null"}
  profile_image_url {label: "varchar, null"}
  avatar_image_url {label: "varchar, null"}
  created_at {label: "datetime, not null"}
  updated_at {label: "datetime, not null"}

[tweets]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  content {label: "varchar(140), not null"}
  created_at {label: "datetime, not null"}
  updated_at {label: "datetime, not null"}

[likes]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users), uniq(user_id, tweet_id)"}
  tweet_id {label: "bigint, not null, FK(tweets), uniq(user_id, tweet_id)"}
  created_at {label: "datetime, not null"}
  updated_at {label: "datetime, not null"}

[retweets]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users), uniq(user_id, tweet_id)"}
  tweet_id {label: "bigint, not null, FK(tweets), uniq(user_id, tweet_id)"}
  created_at {label: "datetime, not null"}
  updated_at {label: "datetime, not null"}

[bookmarks]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users), uniq(user_id, tweet_id)"}
  tweet_id {label: "bigint, not null, FK(tweets), uniq(user_id, tweet_id)"}
  created_at {label: "datetime, not null"}
  updated_at {label: "datetime, not null"}

[follows]
  *id {label: "bigint, not null"}
  follower_id {label: "bigint, not null, FK(users), uniq(follower_id, followee_id)"}
  followee_id {label: "bigint, not null, FK(users), uniq(follower_id, followee_id)"}
  created_at {label: "datetime, not null"}
  updated_at {label: "datetime, not null"}

[direct_messages]
  *id {label: "bigint, not null"}
  sender_id {label: "bigint, not null, FK(users)"}
  receiver_id {label: "bigint, not null, FK(users)"}
  content {label: "text, not null"}
  created_at {label: "datetime, not null"}
  updated_at {label: "datetime, not null"}

[notifications]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  like_id {label: "bigint, null, uniq, FK(likes)"}
  follow_id {label: "bigint, null, uniq, FK(follows)"}
  read_at {label: "datetime, null"}
  created_at {label: "datetime, not null"}
  updated_at {label: "datetime, not null"}

# Cardinality    Syntax
# 0 or 1         ?
# exactly 1      1
# 0 or more      *
# 1 or more      +
users 1--* tweets {label: "posts"}
users 1--* likes {label: "likes"}
tweets 1--* likes {label: "liked by"}
users 1--* retweets {label: "retweets"}
tweets 1--* retweets {label: "retweeted by"}
users 1--* bookmarks {label: "bookmarks"}
tweets 1--* bookmarks {label: "bookmarked by"}
users 1--* follows {label: "follower"}
users 1--* follows {label: "followee"}
users 1--* direct_messages {label: "sender"}
users 1--* direct_messages {label: "receiver"}
users 1--* notifications {label: "receives"}
likes ?--? notifications {label: "triggers"}
follows ?--? notifications {label: "triggers"}
